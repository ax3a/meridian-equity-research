# Copy to .env and fill in what you have. Everything is optional: with no keys the platform runs in
# offline LLM mode against free SEC/market data (and recorded snapshots when offline).

ENV=development
LOG_LEVEL=INFO
LOG_JSON=false

# ---- API security ----
# When set, every /api/v1 request must send header `X-API-Key: <value>`.
API_KEY=
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=240

# ---- Storage ----
DATABASE_URL=postgresql+asyncpg://meridian:meridian@localhost:5432/meridian
REDIS_URL=redis://localhost:6379/0

# ---- LLM ----
# auto = Anthropic if ANTHROPIC_API_KEY is set, otherwise deterministic offline mode (no cost).
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
MODEL_PLANNER=claude-opus-5
MODEL_WORKER=claude-sonnet-5
MODEL_CRITIC=claude-opus-5
MODEL_WRITER=claude-opus-5
# Reasoning depth per tier: low | medium | high | xhigh | max (lower = cheaper)
EFFORT_PLANNER=high
EFFORT_WORKER=medium
EFFORT_CRITIC=high
EFFORT_WRITER=medium

# ---- Data ----
# live = network only · snapshot = recorded fixtures only · auto = live with snapshot fallback
DATA_MODE=auto
# SEC requires a descriptive User-Agent with contact details: "Company/Name email@domain"
SEC_USER_AGENT=Meridian Research Platform your-email@example.com

# Optional paid/free-key providers (adapters activate automatically when a key is present)
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
POLYGON_API_KEY=
FRED_API_KEY=

# ---- RAG ----
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- Workflow ----
REQUIRE_APPROVAL_DEFAULT=true
MAX_REVISION_ROUNDS=2
AGENT_TIMEOUT_SECONDS=300

# ---- Observability (optional) ----
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGSMITH_API_KEY=

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
